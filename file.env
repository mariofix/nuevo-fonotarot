# Example environment file for nuevo-fonotarot.
# Copy this file to .env and fill in the values.

# Flask secret key (required) — change this to a long random string.
SECRET_KEY=change-me-to-a-random-secret-key

# Database URL (SQLAlchemy connection string).
# Default: SQLite database in the instance folder.
DATABASE_URL=sqlite:///fonotarot.db

# Flask environment: development | production | testing
FLASK_ENV=development

# Enable Flask debug mode (true/false)
FLASK_DEBUG=true

# Rate limiting storage backend URI (optional).
# Defaults to in-memory storage when not set.
# Example with Redis: redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://

# Flask-Security password salt (required) — change this to a long random string.
SECURITY_PASSWORD_SALT=change-me-to-a-random-password-salt

# Flask-Admin / Flask-Babel locale (en_US | es_CL | pt_BR)
ADMIN_LOCALE=es_CL

# Flow payment gateway (https://www.flow.cl)
FLOW_API_KEY=
FLOW_SECRET_KEY=
# Use https://www.flow.cl/api for production
FLOW_API_URL=https://sandbox.flow.cl/api
# Server-to-server confirmation URL Flow will call after payment.
# Set to your public URL in production, e.g. https://fonotarot.cl/tienda/pago/confirmacion
FLOW_CONFIRMATION_URL=

# Khipu payment gateway (https://khipu.com)
KHIPU_API_KEY=

# Shared secret used by trusted store instances to exchange internal sales data.
# Must match exactly across federated instances of the same store.
MERCHANTS_KEY=change-me-to-a-shared-random-secret
# Optional list of remote store endpoints to aggregate in the admin dashboard.
# Example: https://latam.store.com/api/internal/orders-summary,https://eu.store.com/api/internal/orders-summary
MERCHANTS_EXTERNAL_ENDPOINTS=

# Logging level for the nuevo_fonotarot logger hierarchy.
# Defaults: DEBUG (development), INFO (production), WARNING (testing).
# Valid values: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=DEBUG

# Telegram notifications via Watchtower webhook (optional).
# Format: telegram://BOT_TOKEN@telegram?chats=CHAT_ID&preview=No
# Example: telegram://3243536:sdfksjfnsgnjsgn@telegram?chats=123&preview=No
TELEGRAM_WEBHOOK_URL=

# Firenze API service (internal, not internet-accessible).
# Base URL of the Firenze REST API.
FIRENZE_API_URL=http://firenze.local
# Header credentials for Firenze API requests.
FIRENZE_API_KEY=
FIRENZE_API_SECRET=
# Timeout in seconds for Firenze HTTP requests (defaults to 5).
FIRENZE_API_TIMEOUT=5
